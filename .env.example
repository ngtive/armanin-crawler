# Target site (offset-based pagination: ?start=<offset>, step 20)
START_OFFSET=340
LAST_OFFSET=19800

# Stop after this many list pages (full archive is ~990 pages)
MAX_PAGES=10

# Set false to scrape list-page data only (skips detail pages, ~20x faster)
FOLLOW_DETAILS=true

# Hard cap on total HTTP requests
MAX_REQUESTS=2000

# Politeness / rate control
MIN_CONCURRENCY=2
MAX_CONCURRENCY=4

# Optional proxy
# PROXY_URL=http://user:pass@host:8000